---
const title = "Captures — Screenshot Tool for macOS";
const description = "Captures 是一款开源 macOS 截图工具，支持区域与窗口截图、手动长截图、标注、OCR 和悬浮对照。截图与文字识别在本机完成。";
const url = "https://github.com/KunZhang1997/Captures";
const image = "https://raw.githubusercontent.com/KunZhang1997/Captures/main/website/public/icon.png";
const source = `${url}#build-from-source`;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050505" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={url} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Captures",
      "operatingSystem": "macOS 14+",
      "applicationCategory": "UtilitiesApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": description,
      "url": url,
      "codeRepository": url,
      "license": "https://opensource.org/licenses/MIT",
      "author": {
        "@type": "Person",
        "name": "Kun Zhang",
        "url": "https://github.com/KunZhang1997"
      }
    })} />
  </head>

  <body>
    <main>
      <div class="hero fade" style="--i:0">
        <div class="icon-wrap">
          <img src="/icon.png" alt="Captures app icon" width="96" height="96" />
        </div>
        <h1>Captures</h1>
        <p class="tagline">截图、标注、提取文字，在 Mac 上接着用。</p>
      </div>

      <div class="demo fade" style="--i:1">
        <img src="/demo.gif" alt="上游项目的功能示意动画" width="800" height="500" loading="eager" />
      </div>

      <div class="features fade" style="--i:2">
        <div class="feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 8V5a2 2 0 0 1 2-2h3" />
            <path d="M17 3h3a2 2 0 0 1 2 2v3" />
            <path d="M22 16v3a2 2 0 0 1-2 2h-3" />
            <path d="M7 21H4a2 2 0 0 1-2-2v-3" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <div>
            <h3>截图</h3>
            <p>区域、窗口、全屏与手动长截图</p>
          </div>
        </div>
        <div class="feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
          </svg>
          <div>
            <h3>标注与编辑</h3>
            <p>箭头、文字、马赛克与图片编辑</p>
          </div>
        </div>
        <div class="feature">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
          </svg>
          <div>
            <h3>本机处理</h3>
            <p>截图与 OCR 在本机完成，无需账号</p>
          </div>
        </div>
      </div>

      <div class="cta fade" style="--i:3">
        <a href={source} class="download">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          查看源码与构建说明
        </a>
        <p class="meta">开源开发版&ensp;·&ensp;macOS 14+&ensp;·&ensp;安装包尚未发布</p>
      </div>

      <footer class="fade" style="--i:4">
        <a href={url}>GitHub</a>
        <span class="dot"></span>
        <a href={`${url}/issues`}>反馈问题</a>
        <span class="dot"></span>
        <a href="https://github.com/nickshatilo/snapper">基于 Nick Shatilo 的 Snapper</a>
      </footer>
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
    overflow: auto;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    background: #050505;
    color: #e4e4e7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 60% at 50% 35%,
      rgba(99, 102, 241, 0.05) 0%,
      rgba(59, 130, 246, 0.03) 30%,
      transparent 70%
    );
    pointer-events: none;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 3rem 2rem 4rem;
    position: relative;
  }

  /* Fade-in animation */
  .fade {
    animation: fadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 0.1s);
    opacity: 0;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .icon-wrap {
    position: relative;
    margin-bottom: 0.25rem;
  }

  .icon-wrap::after {
    content: '';
    position: absolute;
    inset: -40px;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.12) 0%,
      transparent 70%
    );
    filter: blur(20px);
    z-index: -1;
  }

  .icon-wrap img {
    width: 96px;
    height: 96px;
    border-radius: 22px;
  }

  h1 {
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: #fafafa;
    line-height: 1;
  }

  .tagline {
    font-size: 1.15rem;
    color: #71717a;
    font-weight: 400;
  }

  /* Demo */
  .demo {
    width: 100%;
    max-width: 640px;
    position: relative;
  }

  .demo img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 0 48px rgba(99, 102, 241, 0.06);
  }

  /* Features */
  .features {
    display: flex;
    gap: 0.75rem;
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 14px;
    min-width: 180px;
    transition: border-color 0.25s ease;
  }

  .feature:hover {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .feature svg {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    margin-top: 1px;
    color: #6366f1;
  }

  .feature h3 {
    font-size: 0.9rem;
    font-weight: 600;
    color: #e4e4e7;
    margin-bottom: 0.15rem;
  }

  .feature p {
    font-size: 0.8rem;
    color: #71717a;
    line-height: 1.35;
  }

  /* CTA */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    text-decoration: none;
    border-radius: 13px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    transition: all 0.25s ease;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 0 24px rgba(99, 102, 241, 0.15);
  }

  .download:hover {
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.3),
      0 0 40px rgba(99, 102, 241, 0.25);
    transform: translateY(-1px);
  }

  .download:active {
    transform: translateY(0);
  }

  .download svg {
    width: 18px;
    height: 18px;
  }

  .meta {
    font-size: 0.78rem;
    color: #3f3f46;
    letter-spacing: 0.01em;
  }

  /* Footer */
  footer {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  footer a {
    color: #52525b;
    text-decoration: none;
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  footer a:hover {
    color: #a1a1aa;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #27272a;
  }

  /* Mobile */
  @media (max-width: 700px) {
    main {
      padding: 3rem 1.5rem 5rem;
      gap: 1.75rem;
    }

    .demo {
      max-width: 100%;
    }

    h1 {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1rem;
    }

    .features {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .feature {
      min-width: unset;
    }

    footer {
      position: relative;
      bottom: unset;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 1rem;
    }
  }
</style>
